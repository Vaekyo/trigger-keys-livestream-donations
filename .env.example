# ============================================================
#  Salin file ini jadi .env lalu isi. JANGAN share / commit .env
#  (start.bat otomatis membuat .env dari file ini kalau belum ada)
# ============================================================

# ---------- Trakteer.id ----------
# websocket = TANPA ngrok/tunnel (disarankan). Pakai "My Channel ID" di
#             trakteer.id/manage/webhook -> tab "Via Websocket"
# webhook   = tab "Via Http", butuh ngrok/tunnel
# off       = nonaktif
# Pilih SATU saja supaya donasi tidak dobel.
TRAKTEER_MODE=websocket

# Mode websocket: salin "My Channel ID" (tab Via Websocket), JANGAN dishare ke orang lain
TRAKTEER_CHANNEL_ID=
# 1 = ikut terima notifikasi tes dari dashboard Trakteer (berguna saat tes)
TRAKTEER_WS_TEST_CHANNEL=1

# Mode webhook: "My Webhook Token" dari tab Via Http
TRAKTEER_WEBHOOK_TOKEN=

# ---------- Tako.id ----------
# Cara A (disarankan): https://tako.id/me/api-keys -> Callback URL + Callback Secret.
#   Request diverifikasi pakai header X-Tako-Signature (HMAC-SHA256).
TAKO_CALLBACK_SECRET=
#   API key yang sama, dipakai untuk mengambil nama + pesan donatur.
TAKO_API_KEY=
# Cara B: webhook di menu Integrasi. Isi kata sandi acak di sini lalu
#   tambahkan ?key=KATASANDI di ujung URL webhook Tako.
TAKO_WEBHOOK_KEY=

# ---------- Streamer.bot (opsional) ----------
# Aktifkan WebSocket Server di Streamer.bot: Servers/Clients > WebSocket Server
STREAMERBOT_ENABLED=0
STREAMERBOT_URL=ws://127.0.0.1:8080/
STREAMERBOT_PASSWORD=
# Nama action Streamer.bot yang dijalankan saat aksi donasi mulai (args: %donor% %amount% %amountText% %action% %message% %platform%)
STREAMERBOT_ALERT_ACTION=Donation Control Alert
# Nama action saat status ON/PAUSED berubah (args: %state% %paused%). Kosongkan kalau tidak perlu.
STREAMERBOT_STATE_ACTION=Donation Control State

# Token untuk toggle dari Streamer.bot / Stream Deck:
#   GET http://127.0.0.1:8787/api/toggle?token=ISI_TOKEN   (juga /api/pause dan /api/resume)
# Isi dengan teks acak panjang.
CONTROL_TOKEN=

# 1 = simpan payload webhook mentah ke logs/raw_webhooks.jsonl (untuk cek format Tako/Trakteer)
LOG_RAW_WEBHOOKS=1
